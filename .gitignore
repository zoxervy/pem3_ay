# ==========================================
# Secrets & Environment Variables
# ==========================================
.env
.env.*
key.properties
**/*.keystore
**/*.jks

# ==========================================
# Logs & Temp
# ==========================================
*.log
*.tmp
*.bak

# ==========================================
# Hanya track folder lib/ (plus pubspec, README, .gitignore, screenshots)
# ==========================================
/*
!/lib/
!/pubspec.yaml
!/README.md
!/.gitignore
!/screenshots/
